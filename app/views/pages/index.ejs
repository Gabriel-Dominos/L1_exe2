<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lista 1 - Exercício 2</title>

    <style>
        .erro-input {
            border: 2px solid red;
            background-color: #ffe6e6;
        }

        .mensagem-erro {
            color: red;
            font-size: 14px;
        }

        .resultado {
            color: green;
        }
    </style>
</head>
<body>

    <h1>Classificar Dia da Semana</h1>

    <form action="/classificar" method="post">

        <label for="dia">Digite um número de 1 a 7:</label>
        <br>

        <input
            type="number"
            name="dia"
            id="dia"
            value="<%= valores.dia %>"
            class="<%= erros.dia ? 'erro-input' : '' %>"
        >

        <br>

        <% if (erros.dia) { %>
            <span class="mensagem-erro">
                Digite um valor válido entre 1 e 7.
            </span>
            <br>
        <% } %>

        <br>

        <button type="submit">
            Classificar
        </button>

    </form>

    <hr>

    <% if (retorno) { %>

        <% if (retorno.erro) { %>

            <h2 style="color:red;">
                <%= retorno.erro %>
            </h2>

        <% } else { %>

            <h2 class="resultado">
                Dia da semana: <%= retorno.semana %>
            </h2>

        <% } %>

    <% } %>

</body>
</html>
