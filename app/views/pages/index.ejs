<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lista 1 Exercício 2</title>
</head>
<body>

    <form action="/classificar" method="post">

        <label for="dia">Digite o dia da semana:</label> <br>

        <input 
            type="number"
            name="dia"
            id="dia"
            value="<%= valores.dia %>"
        > <br>

        <button type="submit">Classificar</button>

    </form>

    <%

        if(retorno){

            if(retorno.erro){
                %>

                <h2 style="color:red;">
                    <%= retorno.erro %>
                </h2>

                <%

            }else{
                %>

                <h2>
                    Dia da semana: <%= retorno.semana %>
                </h2>

                <%
            }

        }else{
            %>

            <h2>Não temos retorno</h2>

            <%
        }

    %>

</body>
</html>
