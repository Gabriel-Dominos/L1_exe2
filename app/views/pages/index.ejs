const express = require("express");
const router = express.Router();

router.get("/", (req, res) => {
    res.render("pages/index", {
        retorno: null,
        valores: {
            dia: ""
        },
        erros: {}
    });
});

router.post("/classificar", (req, res) => {

    // recuperar o dia
    let dia = parseInt(req.body.dia);

    // validação
    if (isNaN(dia) || dia < 1 || dia > 7) {

        return res.render("pages/index", {
            retorno: {
                erro: "Digite um número entre 1 e 7."
            },
            valores: {
                dia: req.body.dia
            },
            erros: {
                dia: true
            }
        });
    }

    // classificação
    let semana = "";

    if (dia == 1) {
        semana = "Domingo";
    } else if (dia == 2) {
        semana = "Segunda-feira";
    } else if (dia == 3) {
        semana = "Terça-feira";
    } else if (dia == 4) {
        semana = "Quarta-feira";
    } else if (dia == 5) {
        semana = "Quinta-feira";
    } else if (dia == 6) {
        semana = "Sexta-feira";
    } else {
        semana = "Sábado";
    }

    res.render("pages/index", {
        retorno: {
            semana: semana
        },
        valores: {
            dia: req.body.dia
        },
        erros: {}
    });

});

module.exports = router;
